# ─────────────────────────────────────────────────────────────────────────────
# ALMATRACE environment variable template
# Copy this file to .env and fill in real values for your local environment.
# NEVER commit .env or any file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Base URL used to build email links (no trailing slash)
APP_BASE_URL=http://localhost:3000

# Application name shown in emails and UI
APP_NAME=ALMATRACE

# ─── Database ────────────────────────────────────────────────────────────────

# Full PostgreSQL connection string for the application role
# Use a non-superuser role with limited privileges in production
DATABASE_URL=postgres://almatrace_app:changeme_local@localhost:5432/almatrace_dev

# Connection pool settings (optional overrides)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=30000

# ─── Session ─────────────────────────────────────────────────────────────────

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be unique per environment
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_64_CHARS

# Session max age in milliseconds (default: 8 hours)
SESSION_MAX_AGE_MS=28800000

# Set to true in production (requires HTTPS)
SESSION_SECURE=false

# ─── Email (UNCONFIRMED — configure once D7 is resolved) ─────────────────────

# SMTP connection string — leave blank until institutional email is approved
# Example: smtp://user:pass@smtp.psgtech.ac.in:587
SMTP_URL=

# Sender address shown in outgoing emails
EMAIL_FROM=noreply@almatrace.local

# ─── Rate Limits ─────────────────────────────────────────────────────────────

# Max login attempts per IP per 15-minute window
RATE_LIMIT_LOGIN_MAX=10

# Max registration attempts per IP per hour
RATE_LIMIT_REGISTER_MAX=5

# Max verification/OTP attempts per IP per 15 minutes
RATE_LIMIT_VERIFY_MAX=10

# ─── Token Rules (UNCONFIRMED — do not change without D1 approval) ───────────

# Token rule engine mode: 'synthetic' | 'configured'
# Must remain 'synthetic' until the department approves the official rule.
TOKEN_RULE_MODE=synthetic

# ─── Logging ─────────────────────────────────────────────────────────────────

# Log level: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL=debug

# Set to 'true' to output pretty-printed logs in development
LOG_PRETTY=true

# ─── Security ────────────────────────────────────────────────────────────────

# CORS allowed origin (comma-separated list in production)
CORS_ORIGIN=http://localhost:3000

# Content Security Policy: 'strict' | 'report-only' | 'off' (use 'strict' in production)
CSP_MODE=strict

# ─── Feature Flags (safe to change) ──────────────────────────────────────────

# Allow new user registrations (set to 'false' during maintenance or post-pilot)
REGISTRATION_OPEN=true

# Show synthetic data warnings in the UI
SYNTHETIC_DATA_BANNER=true
